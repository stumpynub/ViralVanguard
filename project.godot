; Engine configuration file.

config_version=5

[application]

config/name="Neon Core"
config/description="Neon Core (v77), rebuilt in Godot from the original game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
limits/opengl/max_lights_per_object=16
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.0196078, 0.0156863, 0.054902, 1)

[shader_globals]

v77_hemi_sky={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
v77_hemi_ground={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
v77_fog_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
v77_fog_density={
"type": "float",
"value": 0.0
}
v77_debug={
"type": "int",
"value": 0
}
